# stackwg configuration
# Copy to .env and customize

# WireGuard interface name
WG_INTERFACE=wg0

# WireGuard listen port (UDP)
WG_LISTEN_PORT=13231

# Server IP address on the WireGuard interface
WG_ADDRESS=10.100.0.1/24

# Client subnet (for NAT/masquerade)
WG_SUBNET=10.100.0.0/24

# WireGuard MTU
WG_MTU=1420

# HTTP API listen address
API_LISTEN=:9000

# Data directory (peers.json, keys, status)
DATA_DIR=.

# Server private key (hex). Leave empty to auto-generate.
# WG_PRIVATE_KEY=

# WireGuard device log level: 0=quiet, 1=error, 2=info, 3=debug
WG_LOG_LEVEL=2

# External NIC for NAT (auto-detected if empty)
# EXTERNAL_NIC=eth0
