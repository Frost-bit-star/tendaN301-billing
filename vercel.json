{
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "auth/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "pages/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
